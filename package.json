{
  "name": "denlockhart",
  "version": "1.0.0",
  "description": "denlockhart.com — static site hosting Dennis Lockhart's side projects",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "serve . -l 3000",
    "serve:daemon": "pm2 start ecosystem.config.cjs",
    "serve:stop": "pm2 stop denlockhart-site",
    "serve:restart": "pm2 restart denlockhart-site",
    "serve:status": "pm2 status denlockhart-site",
    "serve:logs": "pm2 logs denlockhart-site --lines 50",
    "serve:save": "pm2 save",
    "serve:autostart": "node scripts/install-serve-autostart.mjs",
    "serve:autostart:remove": "node scripts/install-serve-autostart.mjs --remove",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "pdf-lib": "^1.17.1",
    "pm2": "^6.0.14",
    "puppeteer": "^24.36.1",
    "serve": "^14.2.4"
  }
}
