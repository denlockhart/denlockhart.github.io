{
  "id": "basilea",
  "name": "Basilea",
  "sourceNote": "Starter catalog from a published 4th-edition Companion list (Basileans 2026, 2300pts). Not the full 43-entry army. Paladin Knights default to Specialist; High Paladin on Dragon makes their Regiments Core in that battalion.",
  "commandOrders": [
    {
      "name": "Tenacity!",
      "target": "3+",
      "text": "The unit may re-roll a single failed to hit roll in Combat this Turn. It cannot be used to re-roll a dice for an attack that has the Blast special rule."
    },
    {
      "name": "Tactical Retreat!",
      "target": "4+",
      "text": "If the unit performs a Back! order, it may move up to its Sp value, but may not make any pivots. This order may not be issued to a unit carrying a Loot Counter."
    },
    {
      "name": "For the Glory of the Hegemon",
      "target": "5+",
      "text": "Units charging this Turn only. The unit gains the Elite (Combat) special rule."
    },
    {
      "name": "Cleanse",
      "target": "4+",
      "text": "The unit gains Iron Resolve (+1) until the start of its next Turn, and any ongoing effects from spells, and the Frozen status, currently affecting this unit are removed."
    },
    {
      "name": "Aegis of Kolosu",
      "target": "4+",
      "text": "Units with the Faithful Trait only. Until the start of its next Turn, the unit increases its De by one while being targeted by ranged attacks in its front facing."
    },
    {
      "name": "Borne by Angels",
      "target": "5+",
      "text": "Infantry and Large Infantry units only. The unit gains the Fly special rule while executing an Advance! or At the Double! movement order."
    },
    {
      "name": "Fell the Beast",
      "target": "4+",
      "text": "Infantry and Cavalry units only. The unit gains the Slayer (+nD3 – Combat) special rule, where n is the number of successful results on the dice rolled to issue this order."
    }
  ],
