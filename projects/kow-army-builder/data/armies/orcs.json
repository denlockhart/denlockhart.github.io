{
  "id": "orcs",
  "name": "Orcs",
  "sourceNote": "Full Orcs roster from the Mantic Companion list builder (September 2026). Arcane Library spells that Companion hides behind a subscription are not listed. Mount options set Speed as printed.",
  "commandOrders": [
    {
      "name": "Tenacity!",
      "target": "3+",
      "text": "The unit may re-roll a single failed to hit roll in Combat this Turn. It cannot be used to re-roll a dice for an attack that has the Blast special rule."
    },
    {
      "name": "Tactical Retreat!",
      "target": "4+",
      "text": "If the unit performs a Back! order, it may move up to its Sp value, but may not make any pivots. This order may not be issued to a unit carrying a Loot Counter."
    },
    {
      "name": "Green Rage",
      "target": "5+",
      "text": "Units with the Orc or Forged Traits only. When this unit attacks in a Combat this Turn, for each successful hit that rolls a natural 6, those hits are doubled, before rolling to damage (in effect they have Blast (2))."
    },
    {
      "name": "Up and at 'em",
      "target": "4+",
      "text": "Units with the Orc Trait only. The unit gains the Wild Charge (n) special rule where n is the number of successful dice rolled to issue this order."
    }
  ],
