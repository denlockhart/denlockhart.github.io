  "id": "ratkin",
  "name": "Ratkin",
  "sourceNote": "Full Ratkin roster from the Mantic Companion list builder (September 2026). Arcane Library spells that Companion hides behind a subscription are not listed. Mount options set Speed as printed.",
  "commandOrders": [
    {
      "name": "Tenacity!",
      "target": "3+",
      "text": "The unit may re-roll a single failed to hit roll in Combat this Turn. It cannot be used to re-roll a dice for an attack that has the Blast special rule."
    },
    {
      "name": "Tactical Retreat!",
      "target": "4+",
      "text": "If the unit performs a Back! order, it may move up to its Sp value, but may not make any pivots. This order may not be issued to a unit carrying a Loot Counter."
    },
    {
      "name": "Plague Pots",
      "target": "5+",
      "text": "Units with the Ratpack Trait only. The unit gains the Ensnare special rule until start of its next Turn."
    },
    {
      "name": "Scurrying Claws",
      "target": "5+",
      "text": "Units with the Ratpack Trait only. The unit gains the Strider special rule."
    }
  ],
